{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/assets/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/font/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/analytics-maintenance",
      "schedule": "0 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/guide-anotherstay",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/guide-anotherhouse",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "(home|tours)"
        }
      ],
      "destination": "/api/legacy-screen-ko"
    },
    {
      "source": "/tours",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "(home|tours)"
        }
      ],
      "destination": "/api/legacy-screen-ko"
    },
    {
      "source": "/en",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "(home|tours)"
        }
      ],
      "destination": "/api/legacy-screen-en"
    },
    {
      "source": "/en/tours",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "(home|tours)"
        }
      ],
      "destination": "/api/legacy-screen-en"
    },
    {
      "source": "/ja",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "(home|tours)"
        }
      ],
      "destination": "/api/legacy-screen-ja"
    },
    {
      "source": "/ja/tours",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "(home|tours)"
        }
      ],
      "destination": "/api/legacy-screen-ja"
    },
    {
      "source": "/zh-cn",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "(home|tours)"
        }
      ],
      "destination": "/api/legacy-screen-zh-cn"
    },
    {
      "source": "/zh-cn/tours",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "(home|tours)"
        }
      ],
      "destination": "/api/legacy-screen-zh-cn"
    },
    {
      "source": "/zh-tw",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "(home|tours)"
        }
      ],
      "destination": "/api/legacy-screen-zh-tw"
    },
    {
      "source": "/zh-tw/tours",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "(home|tours)"
        }
      ],
      "destination": "/api/legacy-screen-zh-tw"
    }
  ]
}
